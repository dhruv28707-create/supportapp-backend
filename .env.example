# ============ SAFESPACE backend — environment variables ============
# Copy this file to `.env` and fill in real values.
# On Vercel, set these in Project Settings > Environment Variables.

# --- Firebase Admin SDK (REQUIRED — server crashes without these) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Note: keep on ONE line — literal \n escapes are converted to real newlines.
FIREBASE_PRIVATE_KEY=

# --- AI chat providers (REQUIRED — at least one key) ---
# Primary: Qwen2.5-14B-Instruct via OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# Optional overrides for the primary model/provider:
# PRIMARY_MODEL=qwen/qwen-2.5-14b-instruct
# PRIMARY_BASE_URL=https://openrouter.ai/api/v1/chat/completions
# PRIMARY_API_KEY=
# Fallback: Llama 3.1 8B Instruct via Groq (https://console.groq.com/keys)
GROQ_API_KEY=
# Optional override for the fallback model:
# FALLBACK_MODEL=llama-3.1-8b-instant

# --- Razorpay (REQUIRED for payments) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- CORS (optional — sensible production defaults included) ---
# Comma-separated origins allowed to call the API from browsers.
# Use "*" to allow any origin. Defaults to localhost + production domains.
# ALLOWED_ORIGINS=https://your-frontend.com
