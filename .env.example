# ============ SAFESPACE backend — environment variables ============
# Copy this file to `.env` and fill in real values.
# On Vercel, set these in Project Settings > Environment Variables.

# --- Firebase Admin SDK (REQUIRED — server crashes without these) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Note: keep on ONE line — literal \n escapes are converted to real newlines.
FIREBASE_PRIVATE_KEY=

# --- AI chat providers (REQUIRED — at least one key) ---
#
# ORDER MATTERS FOR LATENCY. Groq answers FIRST by default: gpt-oss-20b on
# Groq reaches a first token far quicker than Qwen3-14B on OpenRouter, and
# users notice the wait on every single message. OpenRouter is the fallback,
# so it only serves a reply when Groq errors or hangs.
# Set CHAT_PRIMARY_PROVIDER=openrouter to swap the order back.
# CHAT_PRIMARY_PROVIDER=groq

# Primary (default): GPT-OSS 20B via Groq (https://console.groq.com/keys)
# (Groq shut down llama-3.1-8b-instant on 2026-08-16)
GROQ_API_KEY=
# Optional override for the Groq model:
# GROQ_MODEL=openai/gpt-oss-20b

# Fallback: Qwen3-14B via OpenRouter (https://openrouter.ai/keys)
# (the old qwen/qwen-2.5-14b-instruct slug was removed from OpenRouter)
OPENROUTER_API_KEY=
# Optional override for the OpenRouter model / endpoint:
# OPENROUTER_MODEL=qwen/qwen3-14b
# PRIMARY_BASE_URL=https://openrouter.ai/api/v1/chat/completions
# PRIMARY_API_KEY=

# Legacy aliases (still honored, so existing overrides keep working):
# FALLBACK_MODEL=openai/gpt-oss-20b
# PRIMARY_MODEL=qwen/qwen3-14b

# --- Razorpay (REQUIRED for payments) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- CORS (optional — sensible production defaults included) ---
# Comma-separated origins allowed to call the API from browsers.
# Use "*" to allow any origin. Defaults to localhost + production domains.
# ALLOWED_ORIGINS=https://your-frontend.com

# --- Diagnostics (optional, default: disabled) ---
# GET /api/diagnose reveals which secrets are configured and can trigger
# real upstream calls. Only enable temporarily while debugging.
# ENABLE_DIAGNOSE=true

# --- Chat cost guards (optional) ---
# Per-IP throttle for POST /api/chat (independent of the per-uid quota).
# Generous defaults: 120 msgs / 5 min per IP is far above any human pattern
# so shared-NAT users are unaffected. Only tighten if abuse is IP-focused.
# CHAT_IP_RATE_LIMIT_MAX=120
# CHAT_IP_RATE_LIMIT_WINDOW_MS=300000

# Firebase App Check enforcement (default: disabled). Requires client builds
# that send the X-Firebase-AppCheck header. When enabled: invalid tokens are
# rejected (401); missing tokens still pass but hit the per-IP throttle —
# a gradual rollout that never locks out the existing userbase.
# ENABLE_APP_CHECK=true
# Single-use App Check tokens (replay hardening). Default false keeps retried
# requests working; set true once clients use single-use tokens.
# APP_CHECK_CONSUME=true

# IP throttle hardening (optional):
# HMAC secret for IP rate-limit doc ids (else RAZORPAY_WEBHOOK_SECRET is used).
# IP_HASH_SECRET=
# Trust x-forwarded-for for IP extraction (local dev behind proxy only).
# Never enable in production — it lets clients spoof the throttle key.
# TRUST_FORWARDED_HEADERS=true

# --- Ultimate free trial (optional) ---
# Days after signup during which a NEW account may start the 5-day Ultimate
# free trial (POST /api/trial/start). One trial per account, ever. Default: 7.
# TRIAL_ELIGIBILITY_WINDOW_DAYS=7

# --- Chat history collections (optional) ---
# Comma-separated list of Firestore collections holding app-side chat
# history, deleted when DELETE /api/account wipes the account. Leave unset
# to auto-discover well-known layouts (chats, chatHistory, messages,
# conversations; per-user docs; users/{uid} subcollections).
# CHAT_COLLECTIONS=chats,messages

# Admin token required for ?rzp=1 live Razorpay self-test (send as x-diagnose-token header).
# Without this, ?rzp=1 returns 403 so anon callers cannot mint orders.
# DIAGNOSE_ADMIN_TOKEN=
# Fail-closed limiters (default: fail-open for availability). Set true to deny requests
# during Firestore outages instead of allowing unlimited AI spend.
# RATE_LIMIT_FAIL_CLOSED=true
