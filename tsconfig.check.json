{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "allowJs": false,
    "module": "esnext",
    "target": "es2020",
    "moduleResolution": "node",
    "types": ["node"]
  },
  "include": ["src/**/*", "api/**/*", "scripts/**/*", "tests/**/*"],
  "exclude": ["node_modules", "dist"]
}
