{
  "root": true,
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": 2020,
    "sourceType": "module",
    "project": "./tsconfig.json"
  },
  "plugins": ["@typescript-eslint"],
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/recommended-type-checked",
    "plugin:@typescript-eslint/stylistic-type-checked",
    "prettier"
  ],
  "rules": {
    "@typescript-eslint/no-unused-vars": ["error", { "argsIgnorePattern": "^_" }],
    "@typescript-eslint/no-floating-promises": "error",

    // Handlers validate untyped platform bodies (req.body is `any`) manually at
    // runtime, so unsafe-any rules fire on code that is actually guarded.
    "@typescript-eslint/no-unsafe-assignment": "off",
    "@typescript-eslint/no-unsafe-argument": "off",
    "@typescript-eslint/no-unsafe-member-access": "off",
    "@typescript-eslint/no-unsafe-call": "off",
    "@typescript-eslint/no-unsafe-return": "off",
    "@typescript-eslint/no-base-to-string": "off",

    // Async route handlers self-catch errors; allowing them where void is
    // expected (Express 4 style). Conditional checks stay on.
    "@typescript-eslint/no-misused-promises": [
      "error",
      { "checksVoidReturn": { "arguments": false, "attributes": false } }
    ],

    // Firestore transaction callbacks may legitimately not await, and `||`
    // fallbacks for env vars / string lookups are intentional (empty string
    // must fall through, so ?? would change behavior).
    "@typescript-eslint/require-await": "off",
    "@typescript-eslint/prefer-nullish-coalescing": "off",
    "@typescript-eslint/array-type": "off",

    // Serverless logging runs on console.* (Vercel log drains) — log/warn/error
    // are the codebase convention.
    "no-console": ["warn", { "allow": ["log", "warn", "error"] }]
  },
  "ignorePatterns": ["dist/", "node_modules/", "api/", "*.js"]
}
